HERMES_MODE=shadow
HERMES_HOSTNAME=hermes.example.com
HERMES_MODEL=anthropic/claude-sonnet-4-6

ANTHROPIC_API_KEY=

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_URL=https://hermes.example.com/sms/inbound

ALLOWLIST_PATH=/etc/hermes/allowlist.yaml
PAUSE_FILE=/etc/hermes/PAUSE
STATE_DB=/var/lib/hermes/state.db
HERMES_HOME=/var/lib/hermes/home

RATE_HOURLY=20
RATE_PER_SENDER_DAILY=5
DAILY_SMS_BUDGET_USD=2

HTTP_HOST=127.0.0.1
HTTP_PORT=8000
