# Webull OpenAPI MCP server credentials
# Copy this file to `.env` and fill in your real values.
# Generate API credentials in the Webull OpenAPI developer portal.
# Do NOT commit your real `.env` file — it is gitignored.

WEBULL_APP_KEY=your_app_key
WEBULL_APP_SECRET=your_app_secret

# Region: us | hk | jp  (default: us)
WEBULL_REGION_ID=us

# Environment: prod | uat  (default: prod)
WEBULL_ENVIRONMENT=prod
