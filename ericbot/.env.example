ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the Claude model (default: claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6

# SQLite database path (relative to backend/)
DB_PATH=ericbot.db

# Server config
HOST=0.0.0.0
PORT=8000

# Twilio SMS (Phase 2 — auto-responder)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15555550123
# Set to "true" once your public webhook URL is configured in Twilio,
# to reject inbound requests that fail Twilio signature verification.
TWILIO_VALIDATE_SIGNATURE=false
# Master kill-switch for any automatic SMS sending. Even when a business
# contact has auto_send enabled, nothing goes out unless this is true.
SMS_AUTO_SEND_ENABLED=false
